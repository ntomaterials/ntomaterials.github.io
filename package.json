{
  "name": "nto-profile-test",
  "version": "1.0.0",
  "private": true,
  "description": "Профориентационный тест НТО: подбор профиля олимпиады по ответам школьника. Полностью статический сайт, весь расчёт — в браузере.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/papaparse": "^5.3.15",
    "papaparse": "^5.4.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
